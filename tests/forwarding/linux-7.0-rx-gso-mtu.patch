+	if (!payload || skb_unclone(skb, GFP_ATOMIC))
+		return -ENOMEM;
+	skb_shinfo(skb)->gso_size = mss;
+	skb_shinfo(skb)->gso_segs = DIV_ROUND_UP(payload, mss);
+	return 0;
+}
