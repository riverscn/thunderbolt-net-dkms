+int skb_rx_gso_clamp_mtu(struct sk_buff *skb, unsigned int mtu)
+{
+	unsigned int iphlen, thlen, mss, payload, type;
+	int offset;
+
+	if (!(skb_shinfo(skb)->flags & SKBFL_RX_GSO_MTU) || !skb_is_gso(skb))
+		return 0;
+	type = skb_shinfo(skb)->gso_type;
+	if (skb->encapsulation || skb_has_frag_list(skb) ||
+	    (type != (SKB_GSO_TCPV4 | SKB_GSO_DODGY) &&
+	     type != (SKB_GSO_TCPV6 | SKB_GSO_DODGY)) ||
+	    !skb_transport_header_was_set(skb))
+		return -EINVAL;
